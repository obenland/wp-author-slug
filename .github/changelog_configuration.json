{
  "template": "#{{CHANGELOG}}\n\n**Full Changelog**: #{{UNCATEGORIZED}}",
  "pr_template": "- #{{TITLE}} by @#{{AUTHOR}} in ##{{NUMBER}}",
  "empty_template": "- no changes",
  "label_extractor": [
    {
      "pattern": "bug|fix",
      "target": "$1",
      "flags": "gu"
    },
    {
      "pattern": "enhancement|feature",
      "target": "$1", 
      "flags": "gu"
    }
  ],
  "categories": [
    {
      "title": "## 🚀 Features",
      "labels": ["feature", "enhancement"]
    },
    {
      "title": "## 🐛 Bug Fixes", 
      "labels": ["bug", "fix"]
    },
    {
      "title": "## 📖 Documentation",
      "labels": ["documentation"]
    },
    {
      "title": "## 🧰 Maintenance",
      "labels": ["maintenance", "dependencies"]
    }
  ],
  "ignore_labels": [
    "ignore",
    "Skip Changelog",
    "Release"
  ],
  "sort": "ASC",
  "exclude": {
    "labels": [
      "Skip Changelog",
      "Release"
    ],
    "authors": [
      "dependabot[bot]"
    ]
  }
}