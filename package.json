{
	"name": "wp-author-slug",
	"version": "5.0.0",
	"private": true,
	"description": "Rewrites the author URL to use the user's display name instead of their username.",
	"devDependencies": {
		"@wordpress/env": "^11.4.0",
		"@wordpress/scripts": "^32.0.0"
	},
	"scripts": {
		"wp-env": "wp-env",
		"format": "wp-scripts format",
		"start": "wp-env start",
		"stop": "wp-env stop",
		"destroy": "wp-env destroy",
		"test": "npm run test-php",
		"test-php": "wp-env run tests-cli --env-cwd=/var/www/html/wp-content/plugins/wp-author-slug composer test",
		"test-php-multisite": "wp-env run tests-cli --env-cwd=/var/www/html/wp-content/plugins/wp-author-slug composer test-multisite"
	}
}
